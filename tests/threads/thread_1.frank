mermaid_show_functions()

def test(a, b):
    print(a)
    print(b)
# Immutable obj
a = {}
b = {}
t1 = Thread(test, a, b)
freeze(a)
freeze(b)
start(t1)

# Regions 
r1 = Region()
r2 = Region()

t2 = Thread(test, r1, r2)
r1 = None
r2 = None
start(t2)

# cowns
c1 = Cown(Region())
c2 = Cown(Region())
t3 = Thread(test, c1, c2)
start(t3)

pass()

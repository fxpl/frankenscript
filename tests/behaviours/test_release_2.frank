
r = Region()
# Create a cown using an open region
c1 = Cown(r, "c1")

@name("B1")
when (c1):
    r = c1.value
    c3 = Cown(Region(), "c3")
    c1.value = c3
    when (c1, c3):
        c1.value = c3
    pass()

# Close the region. B1 should now be available for execution,
# as c1 goes from 'Pending' to 'Released' 
r = None
# B1 must either be executable or complete
if is_executable("B1") == False:
    if is_complete("B1") == False:
        unreachable()
pass()


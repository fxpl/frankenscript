
r = Region()
# Create a cown using an open region
c1 = Cown(r, "c1")
c2 = Cown(Region(), "c2")

@name("B1")
when (c1):
    r = c1.value
    c3 = Cown(Region(), "c3")
    c1.value = c3
    when (c1, c3):
        c1.value = c3
    pass()

# Close the region. B1 should now be available for execution,
# as c1 goes from 'pending' to 'Released' 
r = None
# Note that this check only works due to the current default seed
# B1 could complete before this inst. is reached
if is_ready("B1") == False:
    unreachable()

@name("B2")
when (c1, c2):
    c1.value = c2

